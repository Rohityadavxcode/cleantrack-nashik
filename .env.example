# CleanTrack Nashik - Environment Configuration

# Database: SQLite for zero-config local development, or PostgreSQL for cloud/production
# For PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/cleantrack_nashik?schema=public"
DATABASE_URL="file:./dev.db"

# Authentication secret
AUTH_SECRET="cleantrack_nashik_production_jwt_and_session_secret_key_2026"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenStreetMap / Geocoding configuration
NEXT_PUBLIC_MAP_DEFAULT_LAT="19.9975"
NEXT_PUBLIC_MAP_DEFAULT_LNG="73.7898"
NEXT_PUBLIC_MAP_ZOOM="13"

# Storage Service Adapter (local | s3 | cloudinary)
STORAGE_PROVIDER="local"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Notification Gateways (mock | twilio | sendgrid | gupshup)
NOTIFICATION_PROVIDER="mock"
EMAIL_API_KEY=""
SMS_API_KEY=""
WHATSAPP_API_KEY=""

# SLA and Reminders Config
SLA_HIGH_URGENCY_HOURS="24"
SLA_MEDIUM_URGENCY_HOURS="48"
SLA_LOW_URGENCY_HOURS="96"
REMINDER_CHECK_FREQUENCY_HOURS="12"

# Government Integration Mode (mock | enabled)
GOV_INTEGRATION_MODE="mock"
GOV_API_ENDPOINT="https://api.mock.nashikcorporation.org/v1"
